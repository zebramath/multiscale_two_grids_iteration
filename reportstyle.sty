\ProvidesPackage{reportstyle}

\geometry{
    left=2cm,
    right=2cm,
    top=1.75cm,
    bottom=1.75cm,
    headheight=15pt,
    headsep=0.5cm,
    includehead,
    includefoot
}

\renewcommand{\headrulewidth}{0.4pt}

\newcommand{\@repotitle}{未命名报告}
\newcommand{\@repoauthor}{佚名}

\newcommand{\setinfo}[2]{
    \renewcommand{\@repotitle}{#1}
    \renewcommand{\@repoauthor}{#2}
    \title{\tb{\@repotitle}}
    \author{\@repoauthor}
    \date{}
}

\pagestyle{fancy}
\fancyhf{}
\lhead{\tb{\@repotitle}}
\rhead{\tb{\thepage}}

\let\oldmaketitle\maketitle
\renewcommand{\maketitle}{
    \oldmaketitle
    \thispagestyle{fancy}
}

\floatname{algorithm}{算法}
\renewcommand{\algorithmicrequire}{\tb{输入:}}
\renewcommand{\algorithmicensure}{\tb{输出:}}

\sisetup{
    round-mode=figures,
    round-precision=5,
    scientific-notation=true,
    exponent-product=\times,
    table-format=1.4e-2,
    tight-spacing=true
}

\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    citecolor=blue,
    urlcolor=blue,
    pdfstartview=FitH,
}

\newtheorem{theorem}{定理}[section]
\newtheorem{lemma}[theorem]{引理}
\newtheorem{proposition}[theorem]{命题}
\newtheorem{corollary}[theorem]{推论}
\newtheorem{assumption}[theorem]{假设}
\newtheorem{definition}[theorem]{定义}
\newtheorem{remark}[theorem]{注}

\crefname{equation}{}{}
\crefname{figure}{图}{图}
\crefname{table}{表}{表}
\crefname{algorithm}{算法}{算法}
\crefname{listing}{代码}{代码}
\crefname{section}{节}{节}
\crefname{appendix}{附录}{附录}

\crefformat{equation}{~(#2#1#3)}

\crefformat{figure}{图~#2#1#3}
\crefformat{table}{表~#2#1#3}
\crefformat{algorithm}{算法~#2#1#3}
\crefformat{listing}{代码~#2#1#3}
\crefformat{section}{第~#2#1#3~节}
\crefformat{appendix}{附录~#2#1#3}

\crefrangeformat{figure}{图~#3#1#4~至~#5#2#6}
\crefrangeformat{table}{表~#3#1#4~至~#5#2#6}
\crefrangeformat{equation}{~#3(#1)#4~至~#5(#2)#6}

\crefmultiformat{figure}{图~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}
\crefmultiformat{table}{表~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}
\crefmultiformat{equation}{~#2(#1)#3}{ 和~#2(#1)#3}{, #2(#1)#3}{ 和~#2(#1)#3}

\crefname{theorem}{定理}{定理}
\crefname{lemma}{引理}{引理}
\crefname{proposition}{命题}{命题}
\crefname{corollary}{推论}{推论}
\crefname{assumption}{假设}{假设}
\crefname{definition}{定义}{定义}
\crefname{remark}{注}{注}

\Crefname{theorem}{定理}{定理}
\Crefname{lemma}{引理}{引理}
\Crefname{proposition}{命题}{命题}
\Crefname{corollary}{推论}{推论}
\Crefname{assumption}{假设}{假设}
\Crefname{definition}{定义}{定义}
\Crefname{remark}{注}{注}

\crefformat{theorem}{定理~#2#1#3}
\crefformat{lemma}{引理~#2#1#3}
\crefformat{proposition}{命题~#2#1#3}
\crefformat{corollary}{推论~#2#1#3}
\crefformat{assumption}{假设~#2#1#3}
\crefformat{definition}{定义~#2#1#3}
\crefformat{remark}{注~#2#1#3}

\crefrangeformat{theorem}{定理~#3#1#4~至~#5#2#6}
\crefrangeformat{lemma}{引理~#3#1#4~至~#5#2#6}
\crefrangeformat{proposition}{命题~#3#1#4~至~#5#2#6}
\crefrangeformat{corollary}{推论~#3#1#4~至~#5#2#6}
\crefrangeformat{assumption}{假设~#3#1#4~至~#5#2#6}

\crefmultiformat{theorem}
  {定理~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}
\crefmultiformat{lemma}
  {引理~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}
\crefmultiformat{proposition}
  {命题~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}
\crefmultiformat{corollary}
  {推论~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}
\crefmultiformat{assumption}
  {假设~#2#1#3}{ 和~#2#1#3}{, #2#1#3}{ 和~#2#1#3}

\newtheoremstyle{chineseplain}
    {6pt}
    {6pt}
    {\normalfont}
    {}
    {\bfseries}
    {。}
    {0.5em}
    {}

\AtBeginEnvironment{table}{
    \renewcommand{\arraystretch}{1.3}
    \setlength{\tabcolsep}{13pt}
}

\lstset{
    basicstyle=\normalsize\setmonofont{Consolas}\ttfamily,
    keywordstyle=\color{blue},
    stringstyle=\color{purple},
    frame=none,
    breaklines=true,
    showstringspaces=false,
    tabsize=4,
    mathescape=false,
    literate={_}{{\textunderscore}}1
}